<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.swarmcoder</groupId>
    <artifactId>swarmcoder</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>sc-testsupport</artifactId>
  <name>sc-testsupport</name>
  <description>The one place that decides whether a test needing an outside tool runs, and that
    says out loud when one did not. Depended on with test scope by every module that has such a
    test. It is an ordinary jar module rather than a test-jar because a test-jar cannot be
    resolved by "mvn -pl &lt;module&gt; -am test": a test-jar is built in the package phase, which
    a test-phase reactor build never reaches, so -am would fail to resolve it and every worker
    would be forced to install into the shared local repository. Nothing here is on any runtime
    classpath — every consumer declares it &lt;scope&gt;test&lt;/scope&gt;.</description>

  <dependencies>
    <!-- For HostExecution only: @ModelCodeOnThisPc switches it on for one test class. sc-domain is
         the one product module that does not itself depend on this one. -->
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
