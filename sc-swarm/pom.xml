<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.swarmcoder</groupId>
    <artifactId>swarmcoder</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>sc-swarm</artifactId>
  <name>sc-swarm</name>
  <description>Swarm engine: dispatch, diversity matrix, early-kill, clustering, judging, selection.</description>

  <dependencies>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-inference</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-verify</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-syntax</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Reading Java source without a compiler: the outline scanner behind ContractDelivery,
         which is how a candidate is held to the contract types its task was told to deliver. -->
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-knowledge</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-git</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-sandbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-testsupport</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Publishes this module's test classes so FakeVllm — the scripted OpenAI-compatible
           endpoint that lets tests drive the REAL stack offline — can be reused from another
           module's tests instead of being copied a third time. Nothing else needs it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
