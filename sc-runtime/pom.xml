<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.swarmcoder</groupId>
    <artifactId>swarmcoder</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>sc-runtime</artifactId>
  <name>sc-runtime</name>
  <description>AgentRuntime facade over Koog; ModelProfile registry; prompt assembly.</description>

  <dependencies>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-store</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-inference</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-sandbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.koog</groupId>
      <artifactId>koog-agents-jvm</artifactId>
    </dependency>
    <!-- Direct: TextEmittedToolCalls parses a model turn that is not guaranteed to be JSON. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Direct dependency: docker-java-transport-httpclient5 EXCLUDES httpcore5-h2 from its
         httpclient5, and when that resolution path wins, Koog's ktor-apache5 engine loses its
         HTTP/2 classes at runtime (NoClassDefFoundError: H2RequestTargetHost). -->
    <dependency>
      <groupId>org.apache.httpcomponents.core5</groupId>
      <artifactId>httpcore5-h2</artifactId>
    </dependency>
  </dependencies>
</project>
