<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.swarmcoder</groupId>
    <artifactId>swarmcoder</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>sc-workflow</artifactId>
  <name>sc-workflow</name>
  <description>Workflow state machines; invariants.</description>

  <dependencies>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-swarm</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-knowledge</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-lsp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Test-scoped SLF4J binding so tests (esp. the live E2E) emit logs instead of the SLF4J
         no-op provider; without this the internal workflow/sandbox logging is invisible. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-testsupport</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- FakeVllm, the scripted OpenAI-compatible endpoint, and SwarmEngineImpl's own test
         doubles — needed to drive the real swarm engine end to end from a PLAN-produced task, the
         way TheSwarmDeclaresItsOwnDependencyTest proves a worker actually declares a dependency. -->
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-swarm</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
