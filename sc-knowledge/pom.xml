      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- OpenRewrite: the structural index. Apache-2.0; the parsers are type-attributing for
         Java and the Maven parser reads a pom's resolved dependency model. rewrite-java-25 is the
         parser backend for the JDK this build runs on; rewrite-java-21 comes with it so a JDK 21
         runtime still resolves a backend. Versions come from rewrite-bom in the parent. -->
    <!-- Reads the members of a class file the build produced (BuiltTypes), for a contract type an
         annotation processor generates. Already on the runtime classpath through OpenRewrite at
         this same version, but not visible at compile time, so it is declared here. -->
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-tree</artifactId>
      <version>9.10.1</version>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java</artifactId>
      <exclusions>
        <!-- OpenRewrite's gizmo brings the old org.jboss:jandex 2.x; Weld needs io.smallrye:jandex 3.x,
             which keeps the same org.jboss.jandex package. Two jars, one package: Weld loaded the old
             one and failed to start (NoSuchMethodError ClassInfo.annotationsMap, 2026-09-05). -->
        <exclusion>
          <groupId>org.jboss</groupId>
          <artifactId>jandex</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java-25</artifactId>
      <scope>runtime</scope>
      <exclusions>
        <!-- OpenRewrite's gizmo brings the old org.jboss:jandex 2.x; Weld needs io.smallrye:jandex 3.x,
             which keeps the same org.jboss.jandex package. Two jars, one package: Weld loaded the old
             one and failed to start (NoSuchMethodError ClassInfo.annotationsMap, 2026-09-05). -->
        <exclusion>
          <groupId>org.jboss</groupId>
          <artifactId>jandex</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java-21</artifactId>
      <scope>runtime</scope>
      <exclusions>
        <!-- OpenRewrite's gizmo brings the old org.jboss:jandex 2.x; Weld needs io.smallrye:jandex 3.x,
             which keeps the same org.jboss.jandex package. Two jars, one package: Weld loaded the old
             one and failed to start (NoSuchMethodError ClassInfo.annotationsMap, 2026-09-05). -->
        <exclusion>
          <groupId>org.jboss</groupId>
          <artifactId>jandex</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-maven</artifactId>
      <exclusions>
        <!-- OpenRewrite's gizmo brings the old org.jboss:jandex 2.x; Weld needs io.smallrye:jandex 3.x,
             which keeps the same org.jboss.jandex package. Two jars, one package: Weld loaded the old
             one and failed to start (NoSuchMethodError ClassInfo.annotationsMap, 2026-09-05). -->
        <exclusion>
          <groupId>org.jboss</groupId>
          <artifactId>jandex</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-xml</artifactId>
      <exclusions>
        <!-- OpenRewrite's gizmo brings the old org.jboss:jandex 2.x; Weld needs io.smallrye:jandex 3.x,
             which keeps the same org.jboss.jandex package. Two jars, one package: Weld loaded the old
             one and failed to start (NoSuchMethodError ClassInfo.annotationsMap, 2026-09-05). -->
        <exclusion>
          <groupId>org.jboss</groupId>
          <artifactId>jandex</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-testsupport</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
