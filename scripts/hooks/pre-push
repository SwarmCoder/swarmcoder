#!/usr/bin/env bash
# Runs scripts/pre-push-check.sh on what each push is about to publish and stops the push when
# it finds something. Switched on in a checkout with: git config core.hooksPath scripts/hooks
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # a branch or tag being deleted
    base="$remote_sha"
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="origin/master"                        # new on the remote: everything not yet on master
    fi
    "$(git rev-parse --show-toplevel)/scripts/pre-push-check.sh" "$base" "$local_sha" || status=1
done
exit $status
