<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.swarmcoder</groupId>
    <artifactId>swarmcoder</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>sc-sandbox</artifactId>
  <name>sc-sandbox</name>
  <description>Docker sandbox manager (docker-java), action-server protocol client.</description>

  <dependencies>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-core</artifactId>
      <version>3.3.6</version>
    </dependency>
    <!-- zerodep transport (not httpclient5): it supports Windows named pipes (npipe://); the
         Apache httpclient5 transport does not and falls back to tcp://localhost:2375. -->
    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-transport-zerodep</artifactId>
      <version>3.3.6</version>
    </dependency>
    <dependency>
      <groupId>com.swarmcoder</groupId>
      <artifactId>sc-testsupport</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The page checker the UI image is built with, also on the classpath: the verifier sends
           this build's copy into the container, so an image built earlier needs no rebuild. -->
      <resource>
        <directory>images/sc-java-ui</directory>
        <targetPath>sc-browser</targetPath>
        <includes>
          <include>check.js</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
